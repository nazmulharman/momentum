{
  "name": "smart-life-productivity",
  "version": "1.0.0",
  "description": "Smart Life Productivity - Mobile & Desktop Executable App",
  "main": "expo-router/entry",
  "author": "Smart Life Team",
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@types/react": "~19.2.2",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "desktop": "electron electron-main.js",
    "export:web": "npx expo export -p web",
    "deploy:expo": "npx expo export -p web && npx -y eas-cli deploy --prod",
    "package:exe": "electron-packager . \"Smart Life Productivity\" --platform=win32 --arch=x64 --out=dist-desktop --ignore=\"(\\.gradle|android|\\.expo|\\.git|dist-desktop)\" --overwrite",
    "build:exe": "electron-builder --win dir",
    "build:apk": "npx expo prebuild --platform android"
  },
  "build": {
    "appId": "com.smartlife.productivity",
    "productName": "Smart Life Productivity",
    "directories": {
      "output": "dist-desktop"
    },
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "forceCodeSigning": false
    }
  },
  "private": true
}
